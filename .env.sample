# Copy to .env and fill in

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=pantry

# Public URL of the app. Auth.js builds OAuth callbacks from AUTH_URL; without it,
# a reverse proxy or tunnel that rewrites Host sends Google back to localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth (optional). Redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Registration
ALLOW_REGISTRATION=true
ALLOW_FIRST_LOGIN_ADMIN=true
